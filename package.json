{
  "name": "inlinetracelens",
  "displayName": "InlineTraceLens",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "vluzrmos",
  "author": {
    "name": "vluzrmos"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "inlinetracelens.openGraph",
        "title": "%contributes.commands.0.title%",
        "icon": "$(git-merge)"
      },
      {
        "command": "inlinetracelens.toggleBlame",
        "title": "%contributes.commands.1.title%"
      },
      {
        "command": "inlinetracelens.refresh",
        "title": "%contributes.commands.2.title%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "inlinetracelens.openGraph",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "inlinetracelens.openGraph",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "InlineTraceLens",
      "properties": {
        "inlinetracelens.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%contributes.configuration.properties.inlinetracelens.blame.enabled.description%"
        },
        "inlinetracelens.blame.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "%contributes.configuration.properties.inlinetracelens.blame.maxFileBytes.description%"
        },
        "inlinetracelens.blame.messageLength": {
          "type": "number",
          "default": 64,
          "minimum": 10,
          "maximum": 200,
          "description": "%contributes.configuration.properties.inlinetracelens.blame.messageLength.description%"
        },
        "inlinetracelens.graph.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 25,
          "maximum": 1000,
          "description": "%contributes.configuration.properties.inlinetracelens.graph.pageSize.description%"
        },
        "inlinetracelens.git.path": {
          "type": "string",
          "default": "git",
          "scope": "machine",
          "description": "%contributes.configuration.properties.inlinetracelens.git.path.description%"
        },
        "inlinetracelens.blame.displayMode": {
          "type": "string",
          "enum": [
            "decoration",
            "inlay"
          ],
          "default": "decoration",
          "enumDescriptions": [
            "%contributes.configuration.properties.inlinetracelens.blame.displayMode.enumDescriptions.0%",
            "%contributes.configuration.properties.inlinetracelens.blame.displayMode.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.inlinetracelens.blame.displayMode.description%"
        },
        "inlinetracelens.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt-BR",
            "es",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "enumDescriptions": [
            "%contributes.configuration.properties.inlinetracelens.language.enumDescriptions.0%",
            "Português (Brasil)",
            "Español",
            "English"
          ],
          "description": "%contributes.configuration.properties.inlinetracelens.language.description%"
        }
      }
    },
    "colors": [
      {
        "id": "inlinetracelens.blameForeground",
        "description": "%contributes.colors.0.description%",
        "defaults": {
          "dark": "#737d8c",
          "light": "#69717d",
          "highContrast": "#ffffff",
          "highContrastLight": "#000000"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js"
  },
  "icon": "media/icon.png"
}
